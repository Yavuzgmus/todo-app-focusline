{
  "name": "focusline",
  "version": "1.6.0",
  "private": true,
  "description": "FocusLine - görevler, odak, fikirler ve spor takibi",
  "main": "src/main.js",
  "scripts": {
    "build:shared": "esbuild src/shared/shared.js --bundle --format=iife --target=chrome120 --minify --outfile=src/renderer/shared.bundle.js",
    "start": "npm run build:shared && electron .",
    "dist": "npm run build:shared && electron-builder --win"
  },
  "author": "Yavuz Gümüş",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "firebase": "^13.0.0"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0"
  },
  "build": {
    "appId": "com.yavuzgumus.bugununplani",
    "productName": "FocusLine",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/renderer/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusLine",
      "artifactName": "FocusLine-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FocusLine-Tasinabilir-${version}.${ext}"
    }
  }
}
